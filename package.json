{
  "name": "mcu-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "tsx collector/collect.ts",
    "collect:microchip": "tsx collector/refresh-microchip-cli.ts",
    "build:data": "tsx scripts/build.ts",
    "validate:data": "tsx scripts/validate.ts",
    "dev": "pnpm build:data && wrangler dev",
    "test": "pnpm build:data && vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "typecheck": "wrangler types worker-configuration.d.ts && tsc --noEmit",
    "build": "pnpm build:data && pnpm validate:data && wrangler deploy --dry-run --outdir dist",
    "import:st": "tsx collector/import-st.ts"
  },
  "dependencies": {
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@types/node": "^24.0.0",
    "cheerio": "^1.1.0",
    "fast-xml-parser": "^5.3.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.165.0"
  }
}
